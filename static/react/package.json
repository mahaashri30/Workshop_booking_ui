{
  "name": "workshop-booking-auth",
  "version": "1.0.0",
  "description": "React authentication components for Workshop Booking system",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.jsx --bundle --outfile=dist/auth-bundle.js --external:react --external:react-dom",
    "build:prod": "esbuild src/index.jsx --bundle --outfile=dist/auth-bundle.min.js --minify --external:react --external:react-dom",
    "dev": "esbuild src/index.jsx --bundle --outfile=dist/auth-bundle.js --watch --external:react --external:react-dom"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.19.0"
  },
  "browserslist": [
    "defaults",
    "not ie 11"
  ]
}
